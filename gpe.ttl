@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gpe: <https://maple-feng.github.io/gpe/#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://maple-feng.github.io/gpe/> a owl:Ontology ;
    dcterms:title "Geospatial Product Evidence (GPE) Vocabulary" ;
    dcterms:description "Standards-aligned vocabulary for claim-conditioned geospatial product evidence, obligations, and validation." ;
    dcterms:issued "2026-09-02" ;
    owl:versionInfo "1.0" ;
    owl:versionIRI <https://maple-feng.github.io/gpe/v1.0/> .

gpe:ActivationClass a rdfs:Class ; rdfs:label "ActivationClass" ; rdfs:comment "Requirement activation-class resource." .
gpe:Agent a rdfs:Class ; rdfs:label "Agent" ; rdfs:comment "Responsible person/organization/software agent." ; rdfs:subClassOf prov:Agent .
gpe:ApplicabilityState a rdfs:Class ; rdfs:label "ApplicabilityState" ; rdfs:comment "Controlled applicability-state resource." .
gpe:ClaimPathStatus a rdfs:Class ; rdfs:label "ClaimPathStatus" ; rdfs:comment "Controlled claim-level evidence-path status resource." .
gpe:ClaimScope a rdfs:Class ; rdfs:label "ClaimScope" ; rdfs:comment "Semantic scope for ProductClaim." .
gpe:ClaimType a rdfs:Class ; rdfs:label "ClaimType" ; rdfs:comment "Controlled ProductClaim taxonomy resource." .
gpe:DeliveryService a rdfs:Class ; rdfs:label "DeliveryService" ; rdfs:comment "Service exposing one or more ProductRelease resources." ; rdfs:subClassOf dcat:DataService .
gpe:EvidenceState a rdfs:Class ; rdfs:label "EvidenceState" ; rdfs:comment "Controlled evidence-state resource." .
gpe:ExternalBindingRecord a rdfs:Class ; rdfs:label "ExternalBindingRecord" ; rdfs:comment "Traceable preservation of a native external JSON binding without inventing RDF vocabulary IRIs for its JSON fields." .
gpe:LabelSet a rdfs:Class ; rdfs:label "LabelSet" ; rdfs:comment "Versioned reference labels/truth entity." ; rdfs:subClassOf prov:Entity .
gpe:ProcessingActivity a rdfs:Class ; rdfs:label "ProcessingActivity" ; rdfs:comment "Activity that transforms/uses entities and generates a ProductRelease." ; rdfs:subClassOf prov:Activity .
gpe:ProductClaim a rdfs:Class ; rdfs:label "ProductClaim" ; rdfs:comment "Version-specific assertion artifact; its existence does not establish truth." ; rdfs:subClassOf prov:Entity .
gpe:ProductRelease a rdfs:Class ; rdfs:label "ProductRelease" ; rdfs:comment "Versioned geospatial product release that is the subject of ProductClaim." ; rdfs:subClassOf prov:Entity .
gpe:QualityEvidence a rdfs:Class ; rdfs:label "QualityEvidence" ; rdfs:comment "Evidence entity generated by a ValidationAssessment and bearing on a ProductClaim." ; rdfs:subClassOf prov:Entity .
gpe:SourceAsset a rdfs:Class ; rdfs:label "SourceAsset" ; rdfs:comment "Versioned source observation/product/input used by a ProcessingActivity." ; rdfs:subClassOf prov:Entity .
gpe:StructuredAssertion a rdfs:Class ; rdfs:label "StructuredAssertion" ; rdfs:comment "Structured predicate/operator/value/metric/unit payload for one atomic ProductClaim." .
gpe:ValidationAssessment a rdfs:Class ; rdfs:label "ValidationAssessment" ; rdfs:comment "Claim-bounded validation activity." ; rdfs:subClassOf prov:Activity .
gpe:RequirementDefinition a rdfs:Class ; rdfs:label "RequirementDefinition" ; rdfs:comment "Permanent REQ-GPE semantic requirement resource." .
gpe:EvidenceRecord a rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "EvidenceRecord" ; rdfs:comment "Normalized, claim-bounded evidence fact bridging heterogeneous native/RDF representations to a backend-neutral obligation input." .

gpe:aboutProductRelease a rdf:Property ; rdfs:label "aboutProductRelease" ; rdfs:domain gpe:ProductClaim ; rdfs:range gpe:ProductRelease .
gpe:assertedValue a rdf:Property ; rdfs:label "assertedValue" ; rdfs:domain gpe:StructuredAssertion .
gpe:assertionPredicate a rdf:Property ; rdfs:label "assertionPredicate" ; rdfs:domain gpe:StructuredAssertion .
gpe:bearsOnClaim a rdf:Property ; rdfs:label "bearsOnClaim" ; rdfs:domain gpe:QualityEvidence ; rdfs:range gpe:ProductClaim .
gpe:bindingPayload a rdf:Property ; rdfs:label "bindingPayload" ; rdfs:domain gpe:ExternalBindingRecord .
gpe:bindingScope a rdf:Property ; rdfs:label "bindingScope" ; rdfs:domain gpe:ExternalBindingRecord .
gpe:bindingSpecification a rdf:Property ; rdfs:label "bindingSpecification" ; rdfs:domain gpe:ExternalBindingRecord .
gpe:calibrationCondition a rdf:Property ; rdfs:label "calibrationCondition" ; rdfs:domain gpe:ProductClaim .
gpe:claimFamily a rdf:Property ; rdfs:label "claimFamily" ; rdfs:domain gpe:ProductClaim .
gpe:claimSubtype a rdf:Property ; rdfs:label "claimSubtype" ; rdfs:domain gpe:ProductClaim .
gpe:claimType a rdf:Property ; rdfs:label "claimType" ; rdfs:domain gpe:ProductClaim ; rdfs:range gpe:ClaimType .
gpe:confidenceLevel a rdf:Property ; rdfs:label "confidenceLevel" ; rdfs:domain gpe:ProductClaim .
gpe:denominator a rdf:Property ; rdfs:label "denominator" ; rdfs:domain gpe:ProductClaim .
gpe:evaluatesClaim a rdf:Property ; rdfs:label "evaluatesClaim" ; rdfs:domain gpe:ValidationAssessment ; rdfs:range gpe:ProductClaim .
gpe:evidenceUnitCode a rdf:Property ; rdfs:label "evidenceUnitCode" ; rdfs:domain gpe:QualityEvidence .
gpe:hasAssertion a rdf:Property ; rdfs:label "hasAssertion" ; rdfs:domain gpe:ProductClaim ; rdfs:range gpe:StructuredAssertion .
gpe:hasExternalBinding a rdf:Property ; rdfs:label "hasExternalBinding" ; rdfs:range gpe:ExternalBindingRecord .
gpe:hasScope a rdf:Property ; rdfs:label "hasScope" ; rdfs:domain gpe:ProductClaim ; rdfs:range gpe:ClaimScope .
gpe:matchingRule a rdf:Property ; rdfs:label "matchingRule" ; rdfs:domain gpe:ProductClaim .
gpe:measuredValue a rdf:Property ; rdfs:label "measuredValue" ; rdfs:domain gpe:QualityEvidence .
gpe:metric a rdf:Property ; rdfs:label "metric" ; rdfs:domain gpe:StructuredAssertion .
gpe:objectPopulation a rdf:Property ; rdfs:label "objectPopulation" ; rdfs:domain gpe:ClaimScope .
gpe:operatorCode a rdf:Property ; rdfs:label "operatorCode" ; rdfs:domain gpe:StructuredAssertion .
gpe:sceneContext a rdf:Property ; rdfs:label "sceneContext" ; rdfs:domain gpe:ClaimScope .
gpe:spatialScope a rdf:Property ; rdfs:label "spatialScope" ; rdfs:domain gpe:ClaimScope .
gpe:taskContext a rdf:Property ; rdfs:label "taskContext" ; rdfs:domain gpe:ClaimScope .
gpe:temporalScopeEnd a rdf:Property ; rdfs:label "temporalScopeEnd" ; rdfs:domain gpe:ClaimScope .
gpe:temporalScopeStart a rdf:Property ; rdfs:label "temporalScopeStart" ; rdfs:domain gpe:ClaimScope .
gpe:thresholdContext a rdf:Property ; rdfs:label "thresholdContext" ; rdfs:domain gpe:ClaimScope .
gpe:unitCode a rdf:Property ; rdfs:label "unitCode" ; rdfs:domain gpe:StructuredAssertion .
gpe:validFrom a rdf:Property ; rdfs:label "validFrom" ; rdfs:domain gpe:ProductClaim .
gpe:validTo a rdf:Property ; rdfs:label "validTo" ; rdfs:domain gpe:ProductClaim .
gpe:forClaim a rdf:Property ; rdfs:domain gpe:EvidenceRecord ; rdfs:range gpe:ProductClaim .
gpe:forRequirement a rdf:Property ; rdfs:domain gpe:EvidenceRecord ; rdfs:range gpe:RequirementDefinition .
gpe:aboutEntity a rdf:Property ; rdfs:domain gpe:EvidenceRecord .
gpe:evidenceKey a rdf:Property ; rdfs:domain gpe:EvidenceRecord .
gpe:evidenceValue a rdf:Property ; rdfs:domain gpe:EvidenceRecord .
gpe:evidenceQualifier a rdf:Property ; rdfs:domain gpe:EvidenceRecord .
gpe:reqId a rdf:Property ; rdfs:domain gpe:RequirementDefinition .

<https://maple-feng.github.io/gpe/#activationClass/ANY_PRODUCT_CLAIM> a gpe:ActivationClass ; rdfs:label "ANY_PRODUCT_CLAIM" ; dcterms:description "TRUE for any valid ProductClaim bound to a specific ProductRelease version." ; dcterms:identifier "ACT-GPE-01" .
<https://maple-feng.github.io/gpe/#activationClass/OBSERVATION_OR_SOURCE_DEPENDENT_CLAIM> a gpe:ActivationClass ; rdfs:label "OBSERVATION_OR_SOURCE_DEPENDENT_CLAIM" ; dcterms:description "Claim semantics require observation/source acquisition facts or a SourceAsset provenance path." ; dcterms:identifier "ACT-GPE-02" .
<https://maple-feng.github.io/gpe/#activationClass/SAR_DEPENDENT_PRODUCT_CLAIM> a gpe:ActivationClass ; rdfs:label "SAR_DEPENDENT_PRODUCT_CLAIM" ; dcterms:description "The subject/source modality is explicitly SAR or the selected profile declares a SAR-specific binding." ; dcterms:identifier "ACT-GPE-03" .
<https://maple-feng.github.io/gpe/#activationClass/DERIVED_PRODUCT_CLAIM> a gpe:ActivationClass ; rdfs:label "DERIVED_PRODUCT_CLAIM" ; dcterms:description "The ProductRelease is asserted/known to be generated by one or more ProcessingActivity instances." ; dcterms:identifier "ACT-GPE-04" .
<https://maple-feng.github.io/gpe/#activationClass/SUPERVISED_OR_TRUTH_DEPENDENT_CLAIM> a gpe:ActivationClass ; rdfs:label "SUPERVISED_OR_TRUTH_DEPENDENT_CLAIM" ; dcterms:description "The claim's interpretation depends on external reference labels/truth or supervised evaluation." ; dcterms:identifier "ACT-GPE-05" .
<https://maple-feng.github.io/gpe/#activationClass/VALIDATION_OR_PERFORMANCE_CLAIM> a gpe:ActivationClass ; rdfs:label "VALIDATION_OR_PERFORMANCE_CLAIM" ; dcterms:description "Primary claim type is VALIDATION_PERFORMANCE or the assertion invokes a validation metric/protocol." ; dcterms:identifier "ACT-GPE-06" .
<https://maple-feng.github.io/gpe/#activationClass/ANY_VALIDATION_CLAIM> a gpe:ActivationClass ; rdfs:label "ANY_VALIDATION_CLAIM" ; dcterms:description "Claim requires any formal validation assessment, including performance, geospatial quality, uncertainty, or robustness evaluation." ; dcterms:identifier "ACT-GPE-07" .
<https://maple-feng.github.io/gpe/#activationClass/ROBUSTNESS_TRANSFER_OR_UNCERTAINTY_CLAIM> a gpe:ActivationClass ; rdfs:label "ROBUSTNESS_TRANSFER_OR_UNCERTAINTY_CLAIM" ; dcterms:description "Primary claim type is UNCERTAINTY_RELIABILITY or ROBUSTNESS_TRANSFER, or the assertion explicitly invokes these semantics." ; dcterms:identifier "ACT-GPE-08" .
<https://maple-feng.github.io/gpe/#activationClass/GEOSPATIAL_RELEASE_CLAIM> a gpe:ActivationClass ; rdfs:label "GEOSPATIAL_RELEASE_CLAIM" ; dcterms:description "Claim concerns a geospatial ProductRelease whose spatial/temporal/representation semantics materially affect the assertion." ; dcterms:identifier "ACT-GPE-09" .
<https://maple-feng.github.io/gpe/#activationClass/ANY_VERSIONED_PRODUCT_CLAIM> a gpe:ActivationClass ; rdfs:label "ANY_VERSIONED_PRODUCT_CLAIM" ; dcterms:description "TRUE when the ProductClaim is bound to a version-specific ProductRelease, as required by this semantic contract." ; dcterms:identifier "ACT-GPE-10" .
<https://maple-feng.github.io/gpe/#activationClass/SHARED_OR_DELIVERED_PRODUCT_CLAIM> a gpe:ActivationClass ; rdfs:label "SHARED_OR_DELIVERED_PRODUCT_CLAIM" ; dcterms:description "The ProductRelease is externally shared/distributed or the selected profile includes distribution/access obligations." ; dcterms:identifier "ACT-GPE-11" .
<https://maple-feng.github.io/gpe/#activationClass/OPERATIONAL_SERVICE_CLAIM> a gpe:ActivationClass ; rdfs:label "OPERATIONAL_SERVICE_CLAIM" ; dcterms:description "Primary claim type is OPERATIONAL_SERVICE or an explicit service/continuous-operation profile is selected." ; dcterms:identifier "ACT-GPE-12" .

<https://maple-feng.github.io/gpe/#claimType/IDENTITY_RELEASE> a gpe:ClaimType ; rdfs:label "IDENTITY_RELEASE" ; dcterms:description "Assertion about the identity, edition/version, or issuance state of a specific ProductRelease." ; dcterms:identifier "GPE-CT-01" ; gpe:profileStatus "CORE_TAXONOMY" .
<https://maple-feng.github.io/gpe/#claimType/PROVENANCE_PROCESSING> a gpe:ClaimType ; rdfs:label "PROVENANCE_PROCESSING" ; dcterms:description "Assertion about source observations, acquisition characteristics, processing lineage, software/model artifact, or configuration used to produce a ProductRelease." ; dcterms:identifier "GPE-CT-02" ; gpe:profileStatus "CORE_TAXONOMY" .
<https://maple-feng.github.io/gpe/#claimType/SPATIOTEMPORAL_REPRESENTATION> a gpe:ClaimType ; rdfs:label "SPATIOTEMPORAL_REPRESENTATION" ; dcterms:description "Assertion about spatial/temporal extent, CRS, grid, geometry, representation, validity period, or no-data/quality-mask semantics of a ProductRelease." ; dcterms:identifier "GPE-CT-03" ; gpe:profileStatus "CORE_TAXONOMY" .
<https://maple-feng.github.io/gpe/#claimType/VALIDATION_PERFORMANCE> a gpe:ClaimType ; rdfs:label "VALIDATION_PERFORMANCE" ; dcterms:description "Assertion about measured task performance under a declared validation unit, truth source, matching rule, denominator, and evaluation scope." ; dcterms:identifier "GPE-CT-04" ; gpe:profileStatus "CORE_TAXONOMY" .
<https://maple-feng.github.io/gpe/#claimType/GEOSPATIAL_QUALITY> a gpe:ClaimType ; rdfs:label "GEOSPATIAL_QUALITY" ; dcterms:description "Assertion about positional, geolocation, geometric, or spatial-quality characteristics of the ProductRelease." ; dcterms:identifier "GPE-CT-05" ; gpe:profileStatus "CORE_TAXONOMY" .
<https://maple-feng.github.io/gpe/#claimType/UNCERTAINTY_RELIABILITY> a gpe:ClaimType ; rdfs:label "UNCERTAINTY_RELIABILITY" ; dcterms:description "Assertion about predictive calibration, uncertainty, confidence/reliability intervals, or attributable data/model uncertainty." ; dcterms:identifier "GPE-CT-06" ; gpe:profileStatus "CORE_TAXONOMY" .
<https://maple-feng.github.io/gpe/#claimType/ROBUSTNESS_TRANSFER> a gpe:ClaimType ; rdfs:label "ROBUSTNESS_TRANSFER" ; dcterms:description "Assertion about performance stability, transfer, sensitivity, target-domain behavior, or out-of-distribution behavior under declared axes and supervision conditions." ; dcterms:identifier "GPE-CT-07" ; gpe:profileStatus "CORE_TAXONOMY" .
<https://maple-feng.github.io/gpe/#claimType/DISTRIBUTION_ACCESS> a gpe:ClaimType ; rdfs:label "DISTRIBUTION_ACCESS" ; dcterms:description "Assertion about availability, rights, citation, integrity, media/asset delivery, catalogue discovery, or declared interoperability of a ProductRelease." ; dcterms:identifier "GPE-CT-08" ; gpe:profileStatus "CORE_TAXONOMY" .
<https://maple-feng.github.io/gpe/#claimType/OPERATIONAL_SERVICE> a gpe:ClaimType ; rdfs:label "OPERATIONAL_SERVICE" ; dcterms:description "Assertion about a continuing DeliveryService or repeated production workflow, including cadence, latency, availability, maintenance, drift monitoring, incident handling, or audit history." ; dcterms:identifier "GPE-CT-09" ; gpe:profileStatus "CONDITIONAL_TAXONOMY" .
<https://maple-feng.github.io/gpe/#claimType/FITNESS_FOR_USE> a gpe:ClaimType ; rdfs:label "FITNESS_FOR_USE" ; dcterms:description "Assertion that a ProductRelease is suitable for a declared user decision or acceptance context." ; dcterms:identifier "GPE-CT-10" ; gpe:profileStatus "EXPERIMENTAL_EXTENSION" .

<https://maple-feng.github.io/gpe/#state/APPLICABLE> a gpe:ApplicabilityState ; rdfs:label "APPLICABLE" .
<https://maple-feng.github.io/gpe/#state/INDETERMINATE> a gpe:ApplicabilityState ; rdfs:label "INDETERMINATE" .
<https://maple-feng.github.io/gpe/#state/NOT_APPLICABLE> a gpe:ApplicabilityState ; rdfs:label "NOT_APPLICABLE" .
<https://maple-feng.github.io/gpe/#state/SATISFIED> a gpe:EvidenceState ; rdfs:label "SATISFIED" .
<https://maple-feng.github.io/gpe/#state/UNRESOLVED> a gpe:EvidenceState ; rdfs:label "UNRESOLVED" .
<https://maple-feng.github.io/gpe/#state/VIOLATED> a gpe:EvidenceState ; rdfs:label "VIOLATED" .
<https://maple-feng.github.io/gpe/#state/NO_APPLICABLE_BLOCKING_OBLIGATIONS> a gpe:ClaimPathStatus ; rdfs:label "NO_APPLICABLE_BLOCKING_OBLIGATIONS" .
<https://maple-feng.github.io/gpe/#state/PATH_APPLICABILITY_INDETERMINATE> a gpe:ClaimPathStatus ; rdfs:label "PATH_APPLICABILITY_INDETERMINATE" .
<https://maple-feng.github.io/gpe/#state/PATH_COMPLETE> a gpe:ClaimPathStatus ; rdfs:label "PATH_COMPLETE" .
<https://maple-feng.github.io/gpe/#state/PATH_NONCONFORMANT> a gpe:ClaimPathStatus ; rdfs:label "PATH_NONCONFORMANT" .
<https://maple-feng.github.io/gpe/#state/PATH_UNRESOLVED> a gpe:ClaimPathStatus ; rdfs:label "PATH_UNRESOLVED" .
