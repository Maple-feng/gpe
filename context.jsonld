{
  "@context": {
    "@version": 1.1,
    "gpe": "https://maple-feng.github.io/gpe/#",
    "prov": "http://www.w3.org/ns/prov#",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dcterms": "http://purl.org/dc/terms/",
    "dqv": "http://www.w3.org/ns/dqv#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "ProductClaim": "gpe:ProductClaim",
    "ProductRelease": "gpe:ProductRelease",
    "ProcessingActivity": "gpe:ProcessingActivity",
    "SourceAsset": "gpe:SourceAsset",
    "LabelSet": "gpe:LabelSet",
    "ValidationAssessment": "gpe:ValidationAssessment",
    "QualityEvidence": "gpe:QualityEvidence",
    "DeliveryService": "gpe:DeliveryService",
    "Agent": "gpe:Agent",
    "StructuredAssertion": "gpe:StructuredAssertion",
    "ClaimScope": "gpe:ClaimScope",
    "ExternalBindingRecord": "gpe:ExternalBindingRecord",
    "ClaimType": "gpe:ClaimType",
    "ActivationClass": "gpe:ActivationClass",
    "ApplicabilityState": "gpe:ApplicabilityState",
    "EvidenceState": "gpe:EvidenceState",
    "ClaimPathStatus": "gpe:ClaimPathStatus",
    "aboutProductRelease": {"@id": "gpe:aboutProductRelease", "@type": "@id"},
    "claimFamily": {"@id": "gpe:claimFamily", "@type": "@id"},
    "claimType": {"@id": "gpe:claimType", "@type": "@id"},
    "claimSubtype": {"@id": "gpe:claimSubtype"},
    "hasAssertion": {"@id": "gpe:hasAssertion", "@type": "@id"},
    "hasScope": {"@id": "gpe:hasScope", "@type": "@id"},
    "validFrom": {"@id": "gpe:validFrom", "@type": "xsd:dateTime"},
    "validTo": {"@id": "gpe:validTo", "@type": "xsd:dateTime"},
    "assertionPredicate": {"@id": "gpe:assertionPredicate", "@type": "@id"},
    "operatorCode": "gpe:operatorCode",
    "assertedValue": "gpe:assertedValue",
    "metric": {"@id": "gpe:metric", "@type": "@id"},
    "unitCode": "gpe:unitCode",
    "spatialScope": {"@id": "gpe:spatialScope", "@type": "@id"},
    "temporalScopeStart": {"@id": "gpe:temporalScopeStart", "@type": "xsd:dateTime"},
    "temporalScopeEnd": {"@id": "gpe:temporalScopeEnd", "@type": "xsd:dateTime"},
    "objectPopulation": "gpe:objectPopulation",
    "sceneContext": "gpe:sceneContext",
    "taskContext": "gpe:taskContext",
    "thresholdContext": "gpe:thresholdContext",
    "denominator": "gpe:denominator",
    "matchingRule": "gpe:matchingRule",
    "confidenceLevel": {"@id": "gpe:confidenceLevel", "@type": "xsd:decimal"},
    "calibrationCondition": "gpe:calibrationCondition",
    "evaluatesClaim": {"@id": "gpe:evaluatesClaim", "@type": "@id"},
    "bearsOnClaim": {"@id": "gpe:bearsOnClaim", "@type": "@id"},
    "hasExternalBinding": {"@id": "gpe:hasExternalBinding", "@type": "@id"},
    "bindingSpecification": {"@id": "gpe:bindingSpecification", "@type": "@id"},
    "bindingScope": "gpe:bindingScope",
    "bindingPayload": {"@id": "gpe:bindingPayload", "@type": "@json"},
    "measuredValue": "gpe:measuredValue",
    "evidenceUnitCode": "gpe:evidenceUnitCode",
    "generatedAtTime": {"@id": "prov:generatedAtTime", "@type": "xsd:dateTime"},
    "wasAttributedTo": {"@id": "prov:wasAttributedTo", "@type": "@id"},
    "wasGeneratedBy": {"@id": "prov:wasGeneratedBy", "@type": "@id"},
    "used": {"@id": "prov:used", "@type": "@id"},
    "wasRevisionOf": {"@id": "prov:wasRevisionOf", "@type": "@id"},
    "identifier": "dcterms:identifier",
    "issued": {"@id": "dcterms:issued", "@type": "xsd:date"},
    "version": "dcat:version",
    "servesDataset": {"@id": "dcat:servesDataset", "@type": "@id"},
    "endpointURL": {"@id": "dcat:endpointURL", "@type": "@id"},
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "RequirementDefinition": "gpe:RequirementDefinition",
    "EvidenceRecord": "gpe:EvidenceRecord",
    "forClaim": {"@id": "gpe:forClaim", "@type": "@id"},
    "forRequirement": {"@id": "gpe:forRequirement", "@type": "@id"},
    "aboutEntity": {"@id": "gpe:aboutEntity", "@type": "@id"},
    "evidenceKey": "gpe:evidenceKey",
    "evidenceValue": "gpe:evidenceValue",
    "evidenceQualifier": "gpe:evidenceQualifier",
    "reqId": "gpe:reqId"
  }
}
